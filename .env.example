# Copia questo file in .env:  cp .env.example .env
# Valori per lo sviluppo locale. In produzione arrivano da Terraform.

# Postgres locale (docker-compose)
POSTGRES_USER=planetplotted
POSTGRES_PASSWORD=planetplotted
POSTGRES_DB=planetplotted

# Anni da scaricare dalla World Bank
YEAR_FROM=1990
YEAR_TO=2040

# Object storage (Cloudflare R2, S3 o compatibile). Se S3_ENDPOINT è vuoto,
# bronze e render restano su disco in data/.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BRONZE_BUCKET=planetplotted-bronze
S3_RENDERS_BUCKET=planetplotted-renders
