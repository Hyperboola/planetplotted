# Copia questo file in .env:  cp .env.example .env

# Anni da scaricare dalla World Bank
YEAR_FROM=1990
YEAR_TO=2040

# Bronze su object storage (fase cloud, es. Cloudflare R2 o S3).
# Se S3_ENDPOINT è vuoto, i file restano in data/bronze.
S3_ENDPOINT=
S3_BUCKET=worldviz-bronze
S3_ACCESS_KEY=
S3_SECRET_KEY=
